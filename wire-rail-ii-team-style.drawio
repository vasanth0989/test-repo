teSpace=wrap;rounded=0;fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="350" y="936" width="130" height="14" as="geometry"/></mxCell><mxCell id="ld9" value="take over overdue us-east-1 records" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="392" y="1014" width="190" height="14" as="geometry"/></mxCell><mxCell id="ld10" value="re-queue" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="690" y="1019" width="60" height="14" as="geometry"/></mxCell><mxCell id="step1" value="1" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="152" y="302" width="22" height="22" as="geometry"/></mxCell><mxCell id="step2" value="2" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="284" y="570" width="22" height="22" as="geometry"/></mxCell><mxCell id="step3" value="3" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="594" y="650" width="22" height="22" as="geometry"/></mxCell><mxCell id="step4" value="4" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="664" y="702" width="22" height="22" as="geometry"/></mxCell><mxCell id="step5" value="5" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="396" y="853" width="22" height="22" as="geometry"/></mxCell><mxCell id="step6" value="6" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="962" y="802" width="22" height="22" as="geometry"/></mxCell><mxCell id="step7" value="7" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1132" y="690" width="22" height="22" as="geometry"/></mxCell><mxCell id="step8" value="8" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="594" y="538" width="22" height="22" as="geometry"/></mxCell><mxCell id="step9" value="9" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1010" y="360" width="22" height="22" as="geometry"/></mxCell><mxCell id="legend_title" value="Legend" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;labelBackgroundColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1230" y="905" width="300" height="18" as="geometry"/></mxCell><mxCell id="legend_1" value="normal path, pushed" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1290" y="928" width="280" height="14" as="geometry"/></mxCell><mxCell id="legend_2" value="safety net and replication" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1290" y="948" width="280" height="14" as="geometry"/></mxCell><mxCell id="steps" value="1 POST payment&lt;br&gt;2 Conditional put, then 202 Accepted&lt;br&gt;3 Stream event relayed to the submit queue&lt;br&gt;4 UETR delivered to the Submitter&lt;br&gt;5 Claim with a lease&lt;br&gt;6 Detokenise in memory&lt;br&gt;7 POST with idempotency-key = UETR&lt;br&gt;8 Outcome written, relayed to the notify queue&lt;br&gt;9 Callback to PayX, then mark notified" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1230" y="972" width="330" height="118" as="geometry"/></mxCell><mxCell id="cfg_title" value="AWS configuration: settings that matter" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;labelBackgroundColor=none;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1230" y="330" width="380" height="18" as="geometry"/></mxCell><mxCell id="cfg" value="&lt;b&gt;Wire Rail DB&lt;/b&gt;: DynamoDB global table, strongly consistent&lt;br&gt;(2 replicas + witness). Streams on, new and old images. PITR.&lt;br&gt;&lt;b&gt;Relay&lt;/b&gt;: Lambda on the stream, one per region. Filter on&lt;br&gt;push marker + ownerRegion. Retries, then failure destination.&lt;br&gt;&lt;b&gt;Queues&lt;/b&gt;: SQS standard + DLQ. Visibility timeout at least&lt;br&gt;6x the function timeout. DLQ after at least 5 receives.&lt;br&gt;&lt;b&gt;Submitter, Notifier&lt;/b&gt;: Lambda, SQS trigger. Batch size 1.&lt;br&gt;Max concurrency on the trigger. Client timeouts &amp;lt; function&lt;br&gt;timeout &amp;lt; lease &amp;lt; visibility timeout. Proxy to OPF and Turing.&lt;br&gt;&lt;b&gt;Sweeper&lt;/b&gt;: Lambda, EventBridge Scheduler rate(1 minute) per&lt;br&gt;region. Delivered at least once: one run at a time, and&lt;br&gt;nextActionAt moved with a condition before queueing. Heartbeat.&lt;br&gt;&lt;b&gt;Alarms&lt;/b&gt;: oldest unfinished record age, DLQ not empty,&lt;br&gt;sweeper heartbeat missing, breaker open.&lt;br&gt;&lt;i&gt;Functions, Scheduler and the strongly consistent table still&lt;br&gt;need the platform's confirmation.&lt;/i&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;labelBackgroundColor=none;" vertex="1" parent="1"><mxGeometry x="1230" y="352" width="380" height="208" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>