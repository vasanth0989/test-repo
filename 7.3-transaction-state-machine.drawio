<mxfile host="app.diagrams.net" version="24.0.0">
<diagram id="figure-3---transaction-state-machine" name="Figure 3 - Transaction state machine">
<mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1310" pageHeight="640" math="0" shadow="0">
<root>
<mxCell id="0"/>
<mxCell id="1" parent="0"/>
<mxCell id="n409" value="Pre-check on every call: if the UETR exists with a different payloadHash → 409 Conflict, duplicate UETR with different content (record unchanged, alert)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="110" y="50" width="330" height="50" as="geometry"/></mxCell>
<mxCell id="start" value="" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="51" y="216" width="18" height="18" as="geometry"/></mxCell>
<mxCell id="due" value="DUE&lt;br&gt;(202 returned)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="110" y="200" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="sub" value="SUBMITTING&lt;br&gt;(leased)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="420" y="200" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="acc" value="ACCEPTED&lt;br&gt;(terminal)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="770" y="90" width="190" height="50" as="geometry"/></mxCell>
<mxCell id="rej" value="REJECTED&lt;br&gt;(terminal)" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="770" y="200" width="190" height="50" as="geometry"/></mxCell>
<mxCell id="fr" value="FAILED_RETRYABLE&lt;br&gt;5xx · timeout · 401 / 403" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="770" y="330" width="190" height="50" as="geometry"/></mxCell>
<mxCell id="park" value="PARKED&lt;br&gt;max receives or deadline · alert" style="rounded=1;arcSize=30;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="390" y="470" width="220" height="50" as="geometry"/></mxCell>
<mxCell id="nterm" value="Terminal states never call OPF again. A re-call of the UETR returns 200 with the stored outcome. If PayX was never told, the Sweeper dispatches a report-only attempt." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1030" y="70" width="260" height="80" as="geometry"/></mxCell>
<mxCell id="nsweep" value="Recovery Sweeper (Lambda, each region, every minute): pending records of this region stalled past the threshold, or a terminal outcome PayX was not told → dispatch again. Parks a record at its submit deadline. Adopts the unfinished records of a region that is out." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1030" y="165" width="260" height="124" as="geometry"/></mxCell>
<mxCell id="nbrk" value="DUE and FAILED_RETRYABLE also cover a payment that waits while the circuit breaker is open." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=left;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1030" y="304" width="260" height="56" as="geometry"/></mxCell>
<mxCell id="l_lease" value="Submitter lease" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="295" y="204" width="100" height="16" as="geometry"/></mxCell>
<mxCell id="l_loop" value="lease expired (task stopped · region lost) → redelivery, or the Sweeper re-dispatches" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="330" y="128" width="300" height="30" as="geometry"/></mxCell>
<mxCell id="l_acc" value="202" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="690" y="95" width="40" height="16" as="geometry"/></mxCell>
<mxCell id="l_rej" value="400 / 422" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="705" y="206" width="62" height="16" as="geometry"/></mxCell>
<mxCell id="l_fr" value="5xx · timeout · 401 / 403 (alert)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="585" y="262" width="112" height="30" as="geometry"/></mxCell>
<mxCell id="l_back" value="message redelivered after backoff" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="376" width="200" height="16" as="geometry"/></mxCell>
<mxCell id="l_frpark" value="max receives, or submit deadline passed (Sweeper)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="640" y="500" width="215" height="30" as="geometry"/></mxCell>
<mxCell id="l_duepark" value="submit deadline passed (Sweeper)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=9;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="219" y="472" width="170" height="16" as="geometry"/></mxCell>
<mxCell id="l_replay" value="operator replay → dispatched again" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="230" y="565" width="220" height="16" as="geometry"/></mxCell>
<mxCell id="l_build" value="build or validation error → REJECTED at once, returned to PayX as 400 (no third-party call)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="270" y="8" width="560" height="16" as="geometry"/></mxCell>
<mxCell id="foot" value="Every pending state is recoverable without PayX: SQS redelivery handles normal retries; the Sweeper catches anything whose message is gone." style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;" vertex="1" parent="1"><mxGeometry x="110" y="602" width="900" height="18" as="geometry"/></mxCell>
<mxCell id="e_start" style="rounded=0;html=1;strokeColor=#000000;strokeWidth=1;endArrow=classic;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="start" target="due"><mxGeometry relative="1" as="geometry"><mxPoint x="69" y="225" as="sourcePoint"/><mxPoint x="110" y="225" as="targetPoint"/></mxGeometry></mxCell>
