<mxCell id="A" value="PayX POST /wires&lt;br&gt;Idempotency-Key = UETR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="85" width="150" height="50" as="geometry"/></mxCell>
<mxCell id="B" value="build pain.001 V11 JSON in memory (tokenized, deterministic ids)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="230" y="83" width="180" height="54" as="geometry"/></mxCell>
<mxCell id="D1" value="Record exists for UETR?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="450" y="70" width="150" height="80" as="geometry"/></mxCell>
<mxCell id="D2" value="payloadHash matches?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="650" y="70" width="150" height="80" as="geometry"/></mxCell>
<mxCell id="D3" value="Terminal?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="850" y="70" width="130" height="80" as="geometry"/></mxCell>
<mxCell id="E" value="In flight: no change. Recovery is owned by Wire II (the Sweeper)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1030" y="83" width="190" height="54" as="geometry"/></mxCell>
<mxCell id="F" value="202 Accepted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1270" y="85" width="140" height="50" as="geometry"/></mxCell>
<mxCell id="G" value="put-if-new: DUE, dispatch requested (REJECTED if build failed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="435" y="200" width="180" height="54" as="geometry"/></mxCell>
<mxCell id="H" value="202 Accepted + Location (400 if build failed)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="230" y="202" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="I" value="409 Conflict: duplicate UETR, different content (alert)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="640" y="202" width="170" height="50" as="geometry"/></mxCell>
<mxCell id="J" value="200 with the stored outcome. No OPF call" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="835" y="202" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="K" value="DynamoDB stream → EventBridge Pipe (filter: owner = this region AND dispatch requested) → SQS submit queue (message carries the UETR only)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="345" y="340" width="360" height="70" as="geometry"/></mxCell>
<mxCell id="L" value="Recovery Sweeper — Lambda, each region, every minute: stalled or unreported records of this region, and the unfinished records of a region that is out → dispatch requested. It also puts a path-check message on the queue when the region has proven nothing for a minute." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="820" y="333" width="430" height="84" as="geometry"/></mxCell>
<mxCell id="M" value="receive message" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="40" y="585" width="120" height="50" as="geometry"/></mxCell>
<mxCell id="DK" value="Payment or path check?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="190" y="570" width="150" height="80" as="geometry"/></mxCell>
<mxCell id="N" value="POST …/leases to the Wire II API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="400" y="585" width="160" height="50" as="geometry"/></mxCell>
<mxCell id="D5" value="Lease result?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="600" y="570" width="130" height="80" as="geometry"/></mxCell>
<mxCell id="S" value="detokenize BAN (Turing, in memory) · POST stored pain.001 → OPF · same uuid · key = UETR" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="780" y="580" width="210" height="60" as="geometry"/></mxCell>
<mxCell id="U" value="PUT …/outcome to the API" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1030" y="585" width="130" height="50" as="geometry"/></mxCell>
<mxCell id="D6" value="Outcome?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=10;align=center;" vertex="1" parent="1"><mxGeometry x="1200" y="570" width="120" height="80" as="geometry"/></mxCell>
<mxCell id="W" value="change visibility = backoff (SQS redelivers); max receives → DLQ = PARKED (alert)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1355" y="568" width="150" height="84" as="geometry"/></mxCell>
<mxCell id="R" value="refused: not owner · lease held · already reported · deadline passed · breaker open → delete the message (or let it reappear)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="500" y="490" width="340" height="50" as="geometry"/></mxCell>
<mxCell id="P" value="path check: call FIS once (creates no payment) → POST …/breakers/{dependency}/checks → delete the message" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="150" y="690" width="230" height="66" as="geometry"/></mxCell>
<mxCell id="T" value="terminal, not yet reported → go straight to reporting" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="560" y="695" width="210" height="50" as="geometry"/></mxCell>
<mxCell id="V" value="report final status → PayX status API · PATCH statusReported · delete the message" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=11;align=center;" vertex="1" parent="1"><mxGeometry x="1150" y="690" width="220" height="62" as="geometry"/></mxCell>
