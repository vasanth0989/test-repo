<mxCell id="life_opf" style="rounded=0;html=1;strokeColor=#888888;strokeWidth=1;endArrow=none;endFill=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1250" y="66" as="sourcePoint"/><mxPoint x="1250" y="1136.5" as="targetPoint"/></mxGeometry></mxCell>
<mxCell id="p_px" value="PayX" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="20" width="120" height="46" as="geometry"/></mxCell>
<mxCell id="p_rt" value="Routing of PayX calls" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="215" y="20" width="150" height="46" as="geometry"/></mxCell>
<mxCell id="p_east" value="Wire II us-east-1&lt;br&gt;API · queue · Submitter · Sweeper" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="420" y="20" width="220" height="46" as="geometry"/></mxCell>
<mxCell id="p_tbl" value="Global Tables&lt;br&gt;transactions + breaker" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="690" y="20" width="160" height="46" as="geometry"/></mxCell>
<mxCell id="p_west" value="Wire II us-west-2&lt;br&gt;API · queue · Submitter · Sweeper" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="20" width="220" height="46" as="geometry"/></mxCell>
<mxCell id="p_opf" value="OPF (FIS)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=center;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1190" y="20" width="120" height="46" as="geometry"/></mxCell>
<mxCell id="n12" value="Region lost after OPF accepted, before the outcome was stored and before PayX was told" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="365" y="500.5" width="330" height="37" as="geometry"/></mxCell>
<mxCell id="n14" value="API health check fails → new PayX calls go to us-west-2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="165" y="601.5" width="250" height="37" as="geometry"/></mxCell>
<mxCell id="n15" value="PayX has its 202 and waits. It replays once, with the same UETR, only if .WIRECLEARING misses its SLA." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="25" y="652.5" width="250" height="49.5" as="geometry"/></mxCell>
<mxCell id="n20" value="stream → Pipe → SQS → Submitter (us-west-2)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="875" y="870.5" width="270" height="24.5" as="geometry"/></mxCell>
<mxCell id="n26" value="The Sweeper runs in both regions all the time. us-west-2 adopts a us-east-1 record only when us-east-1 is out (breaker open for five minutes, or nothing proven for five minutes), us-west-2 is able (breaker closed and proven within three minutes) and the record has no live lease: oldest first, 60 per sweep. Adopted records are never moved back. When us-east-1 returns, its Submitter's lease request for a stranded message is refused (the owner is now us-west-2) and the message is deleted. A record that never replicated before the loss (the last ~1 s) is not in us-west-2: PayX replays it once with the same UETR when .WIRECLEARING misses its SLA." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;align=left;spacingLeft=8;spacingRight=8;" vertex="1" parent="1"><mxGeometry x="60" y="1057" width="1250" height="49.5" as="geometry"/></mxCell>
<mxCell id="lanet1" value="A  Normal operation — us-east-1 serves the PayX calls" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="94" width="1310" height="18" as="geometry"/></mxCell>
<mxCell id="ml2" value="POST /wires (UETR)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100" y="124" width="180" height="16.5" as="geometry"/></mxCell>
<mxCell id="ml3" value="to us-east-1" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="159.5" width="220" height="16.5" as="geometry"/></mxCell>
<mxCell id="ml4" value="DUE · owner = us-east-1 (pain.001 stored)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="195" width="241.6" height="16.5" as="geometry"/></mxCell>
<mxCell id="ml5" value="202 Accepted — PayX now waits for .WIRECLEARING" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100" y="230.5" width="420" height="16.5" as="geometry"/></mxCell>
<mxCell id="ml6" value="replicate (~1 s); us-west-2 Pipe ignores it (owner ≠ here)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="780" y="266" width="330" height="16.5" as="geometry"/></mxCell>
<mxCell id="ml7" value="path check every minute (creates no payment): us-west-2 stays able" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1016" y="301.5" width="330" height="29" as="geometry"/></mxCell>
<mxCell id="ml8" value="queue → Submitter: POST stored pain.001 (idempotency-key = UETR)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="349.5" width="700" height="16.5" as="geometry"/></mxCell>
<mxCell id="ml9" value="202 Accepted — outcome never recorded" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="540" y="385" width="700" height="16.5" as="geometry"/></mxCell>
<mxCell id="lanet10" value="B  us-east-1 lost mid-flight" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="440.5" width="1310" height="18" as="geometry"/></mxCell>
<mxCell id="lanet13" value="C  Takeover by the us-west-2 Sweeper — no PayX replay needed" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="571.5" width="1310" height="18" as="geometry"/></mxCell>
<mxCell id="ml16" value="new PayX calls now land in us-west-2" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="300" y="716" width="700" height="16.5" as="geometry"/></mxCell>
<mxCell id="ml17" value="Sweeper reads both breaker records: us-east-1 proved nothing for 5 min (out), us-west-2 is able" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="780" y="751.5" width="330" height="29" as="geometry"/></mxCell>
<mxCell id="ml18" value="finds us-east-1's unfinished records with no live lease" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="780" y="799.5" width="320" height="16.5" as="geometry"/></mxCell>
<mxCell id="ml19" value="adopt: owner = us-west-2, dispatch requested" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="780" y="835" width="258.4" height="16.5" as="geometry"/></mxCell>
<mxCell id="ml21" value="Submitter: re-POST the SAME stored pain.001 (key = UETR)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1020" y="909" width="325.6" height="16.5" as="geometry"/></mxCell>
<mxCell id="ml22" value="202 — idempotent repeat, no duplicate wire" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="1020" y="944.5" width="247.2" height="16.5" as="geometry"/></mxCell>
<mxCell id="ml23" value="ACCEPTED (via the API)" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="780" y="980" width="220" height="16.5" as="geometry"/></mxCell>
<mxCell id="ml24" value="final status (PayX status API) → PayX produces .WIRECLEARING" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=10;labelBackgroundColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="100" y="1015.5" width="900" height="16.5" as="geometry"/></mxCell>
